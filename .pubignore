# Controls what `dart pub publish` packs. NOTE: when .pubignore exists, pub
# stops consulting .gitignore in this directory — every exclusion that matters
# for publishing must be repeated here.

# Keys and plaintext models must never be published.
.secrets/
models_src/
*.key
*.tflite

# Design docs stay in the repository; the README links to them there.
litert_crypto_docs/

# Example app: publish only what the pub.dev Example tab and readers need
# (lib/, pubspec, README, the encrypted asset, the config). Runners and
# plaintext inputs stay in the repository.
example/android/
example/windows/
example/test/
example/models_src/
example/build/
example/.secrets/

# Development-only files. tool/ holds host setup scripts; like the docs,
# they stay in the repository and the README links to them there.
tool/
test/
build/
coverage/
*.iml
.idea/
.vscode/
pubspec.lock
*.log
.DS_Store
